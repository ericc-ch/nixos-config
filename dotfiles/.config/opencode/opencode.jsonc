{
  "$schema": "https://opencode.ai/config.json",

  "small_model": "opencode-go/deepseek-v4-flash",
  "lsp": false,

  "permission": {
    "lsp": "deny",
    "todowrite": "deny",
    "external_directory": "allow",
  },

  "agent": {
    "plan": {
      "disable": true,
    },
    "summary": {
      "disable": true,
    },
  },

  "provider": {
    "modal": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Modal",
      "options": {
        "baseURL": "https://inference.us-west.modal.direct/v1",
        "apiKey": "{env:MODAL_PROXY_TOKEN}",
      },
      "models": {
        "erickchristian48--ep-kimi-k3-server.us-west.modal.direct": {
          "name": "Kimi K3",
          "attachment": false,
          "reasoning": true,
          "interleaved": {
            "field": "reasoning_content",
          },
          "temperature": true,
          "tool_call": true,
          "modalities": {
            "input": ["text", "image", "video"],
            "output": ["text"],
          },
        },
      },
    },
  },
}
