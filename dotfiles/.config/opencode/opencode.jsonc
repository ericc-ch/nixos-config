{
  "$schema": "https://opencode.ai/config.json",

  "shell": "bash",
  "small_model": "opencode/space-bunny-free",
  "lsp": false,

  "permissions": [{ "action": "external_directory", "resource": "*", "effect": "allow" }],

  "compaction": {
    "keep": {
      "tokens": 40000,
    },
  },

  "agents": {
    "plan": {
      "hidden": true,
    },
  },
  "websearch": {
    "provider": "random",
  },
}
