{
  "$schema": "https://opencode.ai/config.json",

  "shell": "bash",
  "lsp": false,

  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
  ],

  "agents": {
    "title": {
      "model": "opencode/beam-free#low",
    },
    "plan": {
      "disabled": true,
    },
  },
  "websearch": {
    "provider": "random",
  },

  // Executor Cloud. OAuth, so sign in once per machine from /mcps.
  "mcp": {
    "servers": {
      "executor": {
        "type": "remote",
        "url": "https://mcp.executor.sh/mcp",
      },
    },
  },

  // Auto-compaction targets
  "providers": {
    "opencode-go": {
      "models": {
        "deepseek-v4.1-flash": {
          "limit": {
            "context": 500000,
          },
        },
        "muse-spark-1.3-contributor": {
          "limit": {
            "context": 500000,
          },
        },
        "glm-5.3-flash": {
          "limit": {
            "context": 500000,
          },
        },
      },
    },
  },
}
