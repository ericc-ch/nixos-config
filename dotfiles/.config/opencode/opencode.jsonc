{
  "$schema": "https://opencode.ai/config.json",

  "shell": "bash",
  "small_model": "opencode/beam-free",
  "lsp": false,

  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
  ],

  "agents": {
    "plan": {
      "disabled": true,
    },
  },
  "websearch": {
    "provider": "random",
  },

  // Auto-compaction targets ~300k instead of the catalog's ~1M windows.
  "providers": {
    "opencode-go": {
      "models": {
        "deepseek-v4.1-flash": {
          "limit": {
            "context": 300000,
          },
        },
        "muse-spark-1.3-contributor": {
          "limit": {
            "context": 300000,
          },
        },
        "glm-5.3-flash": {
          "limit": {
            "context": 300000,
          },
        },
      },
    },
  },
}
