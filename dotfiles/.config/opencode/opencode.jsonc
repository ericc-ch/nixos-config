{
  "$schema": "https://opencode.ai/config.json",

  "shell": "bash",
  "lsp": false,

  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
  ],

  "agents": {
    "title": {
      "model": "opencode/beam-free#low",
    },
    "plan": {
      "disabled": true,
    },
  },
  "websearch": {
    "provider": "random",
  },

  "mcp": {
    "servers": {
      "executor": {
        "type": "remote",
        "url": "https://mcp.executor.sh/mcp",
      },
      "browse": {
        "type": "local",
        "command": ["/home/erickc/.local/bin/browse", "mcp"],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update",
        },
      },
    },
  },

  // Smaller context window to force auto compaction earlier
  "providers": {
    "opencode-go": {
      "models": {
        "deepseek-v4.1-flash": {
          "limit": {
            "context": 400000,
          },
        },
        "glm-5.3-flash": {
          "limit": {
            "context": 400000,
          },
        },
      },
    },
  },
}
