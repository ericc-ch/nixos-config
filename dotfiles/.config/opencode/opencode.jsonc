{
  "$schema": "https://opencode.ai/config.json",

  "shell": "bash",
  "small_model": "opencode/cat-jam-free",
  "lsp": false,

  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
  ],

  "agents": {
    "plan": {
      "disabled": true,
    },
  },
  "websearch": {
    "provider": "random",
  },
}
