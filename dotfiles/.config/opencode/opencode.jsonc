{
  "$schema": "https://opencode.ai/config.json",

  "shell": "/run/current-system/sw/bin/bash",

  "small_model": "opencode-go/deepseek-v4-flash",
  "lsp": false,

  "permission": {
    "lsp": "deny",
    "todowrite": "deny",
    "external_directory": "allow",
  },

  "agent": {
    "plan": {
      "disable": true,
    },
    "summary": {
      "disable": true,
    },
  },
}
