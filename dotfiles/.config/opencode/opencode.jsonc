{
  "$schema": "https://opencode.ai/config.json",

  "shell": "bash",
  "lsp": false,

  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
  ],

  // No pull requests, ever, unless the user asks for one in that turn.
  //
  // A policy hard-deny runs after agent rules and after a saved "Allow always"
  // approval, so neither the agent nor a remembered approval can lift it
  // (https://opencode.ai/docs/policies). The leading wildcard catches the
  // command inside a wrapper (`nix develop --command gh pr create`); a
  // `sh -c` form fails the shell scanner instead of running unverified.
  // `gh pr close` and `gh pr view` stay allowed: undoing and reading are fine.
  "policies": [
    { "action": "tool.use", "resource": "shell:*gh pr create*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*gh pr edit*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*gh pr merge*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*gh pr ready*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*gh api*pulls*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*createPullRequest*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*hub pull-request*", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:*glab mr create*", "effect": "deny" },
  ],

  "agents": {
    "title": {
      "model": "opencode/beam-free#low",
    },
    "plan": {
      "disabled": true,
    },
  },
  "websearch": {
    "provider": "random",
  },

  "mcp": {
    "servers": {
      // stdio, not the remote HTTP endpoint: one `executor login` on the CLI
      // and every agent shares the same credentials and grant.
      "executor": {
        "type": "local",
        "command": ["/home/erickc/.local/share/mise/shims/executor", "mcp"],
      },
      "browse": {
        "type": "local",
        "command": ["/home/erickc/.local/bin/browse", "mcp"],
        "environment": {
          "OPENCODE_BROWSER_RUNTIME": "auto-update",
        },
      },
    },
  },

  // Smaller context window to force auto compaction earlier
  "providers": {
    "opencode-go": {
      "models": {
        "deepseek-v4.1-flash": {
          "limit": {
            "context": 300000,
          },
        },
        "glm-5.3-flash": {
          "limit": {
            "context": 300000,
          },
        },
      },
    },
  },
}
