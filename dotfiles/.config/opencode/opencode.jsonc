{
  "$schema": "https://opencode.ai/config.json",

  "shell": "/run/current-system/sw/bin/bash",

  "model": "vercel-eve/glm-5.2",
  "small_model": "opencode-go/mimo-v2.5",
  "lsp": false,

  "providers": {
    "vercel-eve": {
      "name": "Vercel AI Gateway via Eve",
      "env": ["AI_GATEWAY_API_KEY"],
      "package": "@opencode-ai/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "https://ai-gateway.vercel.sh/v1",
      },
      "models": {
        // Validated against models.dev (key zhipuai/glm-5.2): reasoning + tools +
        // structured output, text-only, 1M context / 128K output. The catalog key is
        // vercel-eve (a custom provider), so opencode won't auto-match the models.dev
        // entry — capabilities and limit must be explicit.
        "glm-5.2": {
          "modelID": "zai/glm-5.2",
          "name": "GLM 5.2 (Eve promotion)",
          "family": "glm",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
          },
          "limit": {
            "context": 1000000,
            "output": 131072,
          },
          // Vercel AI Gateway streams reasoning in `reasoning` (not reasoning_content);
          // make the field explicit so opencode parses it instead of defaulting.
          "compatibility": {
            "reasoningField": "reasoning",
          },
          // The gateway's OpenAI-Chat surface takes a nested `reasoning.effort`, NOT
          // OpenAI's flat `reasoning_effort`. Accepted effort: none|minimal|low|medium|high|xhigh.
          // effort and max_tokens are mutually exclusive on the gateway.
          //
          // Base model (no #variant) pins effort=high so plain `vercel-eve/glm-5.2`
          // always reasons strongly; variants overlay this default.
          "body": {
            "reasoning": { "effort": "high" },
          },
          // Variants = none / high / xhigh (skip thinking / strong / max deliberation).
          // The gateway caps at xhigh (~95% of token budget); there is no `max`.
          "variants": [
            {
              "id": "none",
              "body": {
                "reasoning": { "effort": "none" },
              },
            },
            {
              "id": "high",
              "body": {
                "reasoning": { "effort": "high" },
              },
            },
            {
              "id": "xhigh",
              "body": {
                "reasoning": { "effort": "xhigh" },
              },
            },
          ],
        },
      },
    },
  },

  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "todowrite", "resource": "*", "effect": "deny" },
  ],

  "agents": {
    "plan": {
      "disabled": true,
    },
    "summary": {
      "disabled": true,
    },
  },
}
