#!/data/data/com.termux/files/usr/bin/env sh
# adbw — adb, but it connects to this phone first if it isn't connected.
#   adbw shell pm list packages
#   adbw logcat -s AndroidRuntime
case "$1" in
    pair|connect|disconnect|kill-server|start-server|version|devices|mdns|help)
        exec adb "$@" ;;
esac
if ! adb devices | awk 'NR>1 && $2=="device"' | grep -q .; then
    adbc >/dev/null 2>&1 || true
fi
exec adb "$@"
