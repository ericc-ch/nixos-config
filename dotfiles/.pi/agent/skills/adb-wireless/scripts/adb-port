#!/usr/bin/env python3
"""Print the current adb wireless-debugging port, discovered over mDNS.

No arguments: print the _adb-tls-connect port (the one `adb connect` wants).
  --pair:    print the _adb-tls-pairing port (only exists while the pairing
             dialog is open on the phone).
"""
import socket, struct, sys, time

GROUP, PORT = "224.0.0.251", 5353
T_SRV, T_PTR = 33, 12


def enc_name(name):
    out = b""
    for label in name.rstrip(".").split("."):
        out += bytes([len(label)]) + label.encode()
    return out + b"\x00"


def dec_name(data, off):
    labels, jumped, end = [], False, None
    while True:
        n = data[off]
        if n == 0:
            off += 1
            break
        if n & 0xC0 == 0xC0:                      # compression pointer
            if end is None:
                end = off + 2
            off = ((n & 0x3F) << 8) | data[off + 1]
            jumped = True
            continue
        labels.append(data[off + 1:off + 1 + n].decode("latin1"))
        off += 1 + n
    return ".".join(labels), (end if jumped else off)


def parse_srv_ports(data):
    """Yield (service-name, port) for every SRV record in the packet."""
    qd, an, ns, ar = struct.unpack(">HHHH", data[4:12])
    off = 12
    for _ in range(qd):                           # skip questions
        _, off = dec_name(data, off)
        off += 4
    for _ in range(an + ns + ar):
        name, off = dec_name(data, off)
        if off + 10 > len(data):
            return
        rtype, _, _, rdlen = struct.unpack(">HHIH", data[off:off + 10])
        off += 10
        if rtype == T_SRV and rdlen >= 6:
            port = struct.unpack(">H", data[off + 4:off + 6])[0]
            yield name, port
        off += rdlen


def discover(service, timeout=2.5):
    sock = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    sock.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEPORT, 1)
    try:
        sock.bind(("", PORT))
    except OSError:
        pass                                      # fall back to unicast (QU bit)
    try:
        mreq = struct.pack("4sl", socket.inet_aton(GROUP), socket.INADDR_ANY)
        sock.setsockopt(socket.IPPROTO_IP, socket.IP_ADD_MEMBERSHIP, mreq)
    except OSError:
        pass
    sock.setsockopt(socket.IPPROTO_IP, socket.IP_MULTICAST_TTL, 2)
    sock.settimeout(0.4)

    # 0x8001 = class IN with the unicast-response (QU) bit set: ask the
    # responder to unicast back, so this works even if we couldn't bind 5353.
    query = struct.pack(">HHHHHH", 0, 0, 1, 0, 0, 0) + enc_name(service) + struct.pack(">HH", T_PTR, 0x8001)
    sock.sendto(query, (GROUP, PORT))

    ports, deadline = {}, time.time() + timeout
    while time.time() < deadline:
        try:
            data = sock.recvfrom(9000)[0]
        except socket.timeout:
            continue
        except OSError:
            break
        for name, port in parse_srv_ports(data):
            if service.split(".")[0] in name:
                ports[name] = port
        if ports:
            break
    sock.close()
    return ports


def main():
    service = "_adb-tls-pairing._tcp.local." if "--pair" in sys.argv else "_adb-tls-connect._tcp.local."
    found = discover(service)
    if not found:
        sys.exit(1)
    for _, port in found.items():
        print(port)
        return
    sys.exit(1)


if __name__ == "__main__":
    main()
