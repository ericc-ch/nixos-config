#!/data/data/com.termux/files/usr/bin/env sh
# adbc — connect adb to this phone's own wireless-debugging port.
# Prints the serial ("localhost:PORT") on success. Idempotent.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

# mDNS can lag for a moment after the adb server restarts, so give up slowly.
port=$(python3 "$here/adb-port") || { sleep 0.5; port=$(python3 "$here/adb-port"); } || {
    echo "adbc: no _adb-tls-connect advertisement seen." >&2
    echo "      Wireless debugging is off, or still starting up — tap the QS tile." >&2
    exit 1
}
target="localhost:$port"

if adb devices | grep -q "^$target[[:space:]]*device$"; then
    printf '%s\n' "$target"; exit 0
fi

# Drop stale entries for ports the phone used in earlier sessions.
adb devices | awk 'NR>1 && $1 ~ /^localhost:/ {print $1}' |
while read -r old; do adb disconnect "$old" >/dev/null 2>&1; done

n=0
while [ "$n" -lt 3 ]; do
    adb connect "$target" >/dev/null 2>&1
    if adb devices | grep -q "^$target[[:space:]]*device$"; then
        printf '%s\n' "$target"; exit 0
    fi
    n=$((n + 1))
    sleep 0.3
done

echo "adbc: connect to $target failed" >&2
exit 1
