# name: 'Gruvbox Dark Hard'
# preferred_background: 1d2021

[dark]
# preferred_background: 1d2021

# Syntax highlighting
fish_color_normal ebdbb2
fish_color_command b8bb26
fish_color_keyword d3869b
fish_color_quote fabd2f
fish_color_redirection 83a598
fish_color_end a89984
fish_color_error fb4934
fish_color_param d5c4a1
fish_color_comment 7c6f64
fish_color_operator fe8019
fish_color_escape d3869b
fish_color_autosuggestion 7c6f64
fish_color_valid_path b8bb26 --underline
fish_color_option fabd2f
fish_color_status fb4934
fish_color_history_current 8ec07c

# Prompt colors
fish_color_cwd 83a598
fish_color_cwd_root fb4934
fish_color_user b8bb26
fish_color_host fabd2f
fish_color_host_remote fe8019
fish_color_cancel fb4934

# Selection and search
fish_color_selection --background=504945
fish_color_search_match --background=32302f

# Pager colors
fish_pager_color_progress fabd2f
fish_pager_color_background
fish_pager_color_prefix b8bb26
fish_pager_color_completion ebdbb2
fish_pager_color_description 7c6f64
fish_pager_color_selected_background --background=504945
fish_pager_color_selected_prefix b8bb26
fish_pager_color_selected_completion ebdbb2
fish_pager_color_selected_description 7c6f64
fish_pager_color_secondary_background --background=3c3836
fish_pager_color_secondary_prefix b8bb26
fish_pager_color_secondary_completion ebdbb2
fish_pager_color_secondary_description 7c6f64
