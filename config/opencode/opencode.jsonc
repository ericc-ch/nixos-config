{
  "$schema": "https://opencode.ai/config.json",
  "disabled_providers": ["alibaba-coding-plan-cn"],

  "model": "alibaba-coding-plan/kimi-k2.5",
  "lsp": false,

  "permission": {
    "lsp": "deny",
    "todoread": "deny",
    "todowrite": "deny",
    "question": "deny",
  },

  "agent": {
    "title": {
      "disable": true,
    },
    "summary": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
    "explore": {
      "disable": true,
    },
  },

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
    },
  },
}
