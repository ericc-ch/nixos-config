{
  "$schema": "https://opencode.ai/config.json",

  "model": "fireworks-ai/accounts/fireworks/routers/kimi-k2p5-turbo",

  "provider": {
    "fireworks-ai": {
      "whitelist": [
        // "accounts/fireworks/routers/glm-5p1-fast",
        "accounts/fireworks/routers/glm-5-fast",
        "accounts/fireworks/routers/kimi-k2p5-turbo",
        // "accounts/fireworks/routers/minimax-m2p7",
      ],
      "models": {
        "accounts/fireworks/routers/glm-5-fast": {
          "name": "GLM 5 Fast (firepass)",
          "limit": {
            "context": 202752,
            "output": 131072,
          },
        },
        "accounts/fireworks/routers/glm-5p1-fast": {
          "name": "GLM 5.1 Fast (firepass)",
          "limit": {
            "context": 202752,
            "output": 131072,
          },
        },
        "accounts/fireworks/routers/minimax-m2p7": {
          "name": "MiniMax M2.7 (firepass)",
          "limit": {
            "context": 196608,
            "output": 196608,
          },
        },
      },
    },
  },

  "lsp": false,

  "permission": {
    "lsp": "deny",
    "todoread": "deny",
    "todowrite": "deny",
    "question": "deny",
  },

  "agent": {
    "plan": {
      "disable": false,
    },
    "title": {
      "disable": true,
    },
    "summary": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
    "explore": {
      "disable": true,
    },
  },

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
    },
  },
}
