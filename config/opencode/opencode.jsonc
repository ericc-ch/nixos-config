{
  "$schema": "https://opencode.ai/config.json",

  // "model": "kimi-for-coding/k2p5",
  "model": "opencode/minimax-m2.5-free",
  "small_model": "opencode/minimax-m2.5-free",

  "permission": {
    "lsp": "deny",
    "todoread": "deny",
    "todowrite": "deny",

    "external_directory": {
      "/home/*/dotfiles/*": "allow",
      "/home/*/.config/*": "allow",
    },
  },

  "agent": {
    "plan": {
      "permission": {
        "edit": {
          "*plan.md": "allow",
        },
      },
    },
    "general": {
      "model": "opencode/minimax-m2.5-free",
      "disable": true,
    },
    "explore": {
      "model": "opencode/minimax-m2.5-free",
    },
    "review": {
      "model": "kimi-for-coding/k2p5",
    },
    "compaction": {
      "model": "opencode/minimax-m2.5-free",
    },
  },

  "keybinds": {
    "terminal_suspend": "none",
  },
}
