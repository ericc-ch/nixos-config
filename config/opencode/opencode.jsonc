{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "huggingface": {
      "whitelist": ["zai-org/GLM-5.2"],
      "models": {
        "zai-org/GLM-5.2": {
          "name": "GLM-5.2",
          "family": "glm",
          "attachment": false,
          "reasoning": true,
          "tool_call": true,
          "interleaved": {
            "field": "reasoning_content",
          },
          "temperature": true,
          "release_date": "2026-06-13",
          "modalities": {
            "input": ["text"],
            "output": ["text"],
          },
          "limit": {
            "context": 202752,
            "output": 131072,
          },
          "cost": {
            "input": 1,
            "output": 3.2,
            "cache_read": 0.2,
          },
        },
      },
    },
  },

  "lsp": false,

  "permission": {
    "lsp": "deny",
    "task": "deny",
    "todowrite": "deny",
    "question": "deny",
    "codesearch": "deny",
    "skill": "deny",
  },

  "agent": {
    "plan": {
      "disable": true,
    },
    "title": {
      "disable": true,
    },
    "summary": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
    "explore": {
      "disable": true,
    },
    "scout": {
      "disable": true,
    },
  },

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
    },
  },
}
