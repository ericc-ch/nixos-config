{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "fireworks-ai": {
      "whitelist": ["accounts/fireworks/routers/kimi-k2p5-turbo"],
    },
  },

  "lsp": false,

  "permission": {
    "lsp": "deny",
    "task": "deny",
    "todowrite": "deny",
    "question": "deny",
    "codesearch": "deny",
    "skill": "deny",
  },

  "agent": {
    "plan": {
      "disable": true,
    },
    "title": {
      "disable": true,
    },
    "summary": {
      "disable": true,
    },
    "general": {
      "disable": true,
    },
    "explore": {
      "disable": true,
    },
    "scout": {
      "disable": true,
    },
  },

  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": false,
    },
  },
}
