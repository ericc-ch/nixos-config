
binds {
    // Applications
    Mod+T repeat=false { spawn "kitty" "--single-instance"; }
    Mod+E repeat=false { spawn "nautilus"; }
    Alt+Space repeat=false { spawn "vicinae" "toggle"; }

    // Handy (offline dictation)
    Mod+H repeat=false { spawn "handy" "--toggle-transcription"; }
    Mod+Shift+H repeat=false { spawn "handy" "--toggle-post-process"; }

    // Audio
    XF86AudioRaiseVolume allow-when-locked=true { spawn "pamixer" "-u" "-i" "5"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "pamixer" "-u" "-d" "5"; }
    XF86AudioMute        allow-when-locked=true { spawn "pamixer" "-t"; }

    // Brightness
    XF86MonBrightnessUp   allow-when-locked=true { spawn "brightnessctl" "set" "+5%"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "set" "5%-"; }

    // Overview
    Mod+Tab repeat=false { toggle-overview; }

    // Window management
    Mod+F4 repeat=false { close-window; }
    Alt+F4 repeat=false { close-window; }

    // Focus: WASD navigation
    Mod+W { focus-window-or-workspace-up; }
    Mod+A { focus-column-or-monitor-left; }
    Mod+S { focus-window-or-workspace-down; }
    Mod+D { focus-column-or-monitor-right; }

    // Focus: Arrow key navigation
    Mod+Up { focus-window-or-workspace-up; }
    Mod+Left { focus-column-or-monitor-left; }
    Mod+Down { focus-window-or-workspace-down; }
    Mod+Right { focus-column-or-monitor-right; }

    // Move: Ctrl + WASD
    Mod+Shift+W { move-window-up-or-to-workspace-up; }
    Mod+Shift+A { move-column-left-or-to-monitor-left; }
    Mod+Shift+S { move-window-down-or-to-workspace-down; }
    Mod+Shift+D { move-column-right-or-to-monitor-right; }

    // Move: Arrow keys
    Mod+Shift+Up { move-window-up-or-to-workspace-up; }
    Mod+Shift+Left { move-column-left-or-to-monitor-left; }
    Mod+Shift+Down { move-window-down-or-to-workspace-down; }
    Mod+Shift+Right { move-column-right-or-to-monitor-right; }

    // Column stacks: ZXC
    Mod+Z { consume-or-expel-window-left; }
    Mod+X { expel-window-from-column; }
    Mod+C { consume-or-expel-window-right; }

    // Column/Window maximization
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+R { switch-preset-column-width; }

    // Screenshots
    Print repeat=false { screenshot; }
    Mod+Print repeat=false { screenshot-screen; }

    // Keyboard shortcuts inhibitor escape hatch
    Mod+Escape allow-inhibiting=false repeat=false { toggle-keyboard-shortcuts-inhibit; }
}
