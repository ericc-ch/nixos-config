{
  "cli_default_open_behavior": "new_window",

  "tab_size": 2,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)",
  },
  "ui_font_size": 16,
  "buffer_font_size": 14,
  "buffer_font_family": "JetBrainsMono Nerd Font Mono",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },

  "vim_mode": false,
  "vim": {
    "toggle_relative_line_numbers": true,
  },

  "agent_servers": {
    "cursor": {
      "type": "registry",
