.opencode/

.qmlls.ini
.qmllint.ini

# opencode runtime files (also in dotfiles/.config/opencode/.gitignore)
dotfiles/.config/opencode/node_modules/
dotfiles/.config/opencode/package.json
dotfiles/.config/opencode/bun.lock
dotfiles/.config/opencode/cli.json
dotfiles/.config/opencode/package-lock.json
dotfiles/.config/opencode/service.json

# local machine env/secrets (never commit)
dotfiles/.config/fish/conf.d/local.fish

# pi runtime data (not config)
dotfiles/.pi/agent/bin/
dotfiles/.pi/agent/auth.json
dotfiles/.pi/agent/models-store.json
dotfiles/.pi/agent/sessions/
dotfiles/.pi/agent/settings.json
dotfiles/.pi/agent/trust.json

# pi extension packages: deps are for editor type resolution only (regenerated by npm install)
dotfiles/.pi/agent/extensions/*/node_modules/
dotfiles/.pi/agent/extensions/*/package-lock.json
dotfiles/.pi/agent/extensions/*/bun.lock
