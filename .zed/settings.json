{
  "lsp": {
    "deno": {
      "settings": {
        "deno": {
          "enable": true,
        },
      },
    },
    "nixd": {
      "settings": {
        "nixd": {
          "nixpkgs": {
            "expr": "import <nixpkgs> { }"
          },
          "formatting": {
            "command": [ "nixfmt" ]
          },
          "options": {
            "nixos": {
              "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.gl503ge.options"
            },
            "home-manager": {
              "expr": "(builtins.getFlake (builtins.toString ./.)).nixosConfigurations.gl503ge.options.home-manager.users.type.getSubOptions []"
            }
          }
        }
      }
    }
  },
  "languages": {
    "Nix": {
      "language_servers": [ "nixd", "!nil" ]
    },
    "JavaScript": {
      "language_servers": [
        "deno",
        "!typescript-language-server",
        "!vtsls",
        "!eslint",
      ],
      "formatter": "language_server",
    },
    "TypeScript": {
      "language_servers": [
        "deno",
        "!typescript-language-server",
        "!vtsls",
        "!eslint",
      ],
      "formatter": "language_server",
    },
    "TSX": {
      "language_servers": [
        "deno",
        "!typescript-language-server",
        "!vtsls",
        "!eslint",
      ],
      "formatter": "language_server",
    },
  },
}
