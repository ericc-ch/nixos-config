{
  "lsp": {
    "nixd": {
      "settings": {
        "nixd": {
          "nixpkgs": {
            "expr": "import <nixpkgs> { }"
          },
          "formatting": {
            "command": ["nixfmt"]
          }
        }
      }
    },
    "tombi": {
      "binary": {
        "arguments": ["lsp"]
      }
    }
  },
  "languages": {
    "Nix": {
      "language_servers": ["nixd", "!nil"]
    }
  }
}
