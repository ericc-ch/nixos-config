#!/bin/sh
# rebuild: Rebuild NixOS configuration

if [ ! -f "flake.nix" ]; then
    echo "Error: flake.nix not found in current directory" >&2
    exit 1
fi

if [ -z "$1" ]; then
    echo "Usage: $0 <hostname>" >&2
    echo "Available hosts: hp240g5 gl503ge" >&2
    exit 1
fi

exec sudo nixos-rebuild switch --flake ".#$1" "${@:2}"
